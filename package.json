{
  "name": "songlist-saas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check:all": "npm run lint && npm run build && npm run test",
    "beta:check": "node scripts/beta-check.js",
    "beta:check:full": "node scripts/beta-check.js --full",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:studio": "cd apps/api && npx prisma studio",
    "db:generate": "cd apps/api && npx prisma generate",
    "demo:seed": "cd apps/api && npm run db:seed",
    "vercel:link:web": "npx vercel link --cwd apps/web",
    "vercel:deploy:web": "npx vercel deploy --cwd apps/web",
    "vercel:deploy:web:prod": "npx vercel deploy --prod --cwd apps/web"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "turbo": "^2.9.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "react-joyride": "^3.1.0",
    "tmp": "^0.2.5"
  }
}
